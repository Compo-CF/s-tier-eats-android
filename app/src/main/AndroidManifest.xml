<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- COARSE location powers "Top-rated near me" and "Plan a Night Out" near-me
         mode (v1.3). Approximate location is enough for distance sorting/filtering
         and keeps the Play Data Safety footprint minimal. It is requested at
         runtime only when the user opens one of those features; the app works
         fully (search by area) if declined.
         WARNING: Play Data Safety MUST declare "Approximate location - App
         functionality, not shared" for this release or the update can be rejected. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".STierApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.STierEats">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.STierEats">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Friend tier share links. Custom scheme works app-to-app always;
                 the https App Link needs assetlinks.json on the host to auto-open
                 the app (otherwise it lands in the browser on the 404 page, which
                 funnels to the store). MainActivity.handleDeepLink parses both. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="stier" android:host="tier" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="compo-cf.github.io"
                    android:pathPrefix="/woodlands-eats/tier" />
            </intent-filter>

            <!-- Shared Lists: stier://list/<id> + https list path. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="stier" android:host="list" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="compo-cf.github.io"
                    android:pathPrefix="/woodlands-eats/list" />
            </intent-filter>
        </activity>

        <!-- Google Maps SDK key, injected via manifestPlaceholder (CI secret). -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- AdMob app ID (Android). Not a secret — every AdMob app declares it
             in the manifest; MobileAds.initialize crashes without it. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-1927040492403163~2050571508" />

        <!-- FileProvider for sharing rendered card PNGs (tier list, stats) out
             of cacheDir/shared_images via a content:// URI. Authority mirrors
             ShareCapture.kt ("<package>.fileprovider"). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
